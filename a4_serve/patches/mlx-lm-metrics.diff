+    def handle_metrics(self):
+        """
+        MLX-MADS METRICS PATCH (CS2680 A4).
+
+        Render a Prometheus text snapshot of the engine: prompt-cache (KV
+        prefix-reuse) state, in-flight/queued request counts, and the
+        batch generator's token/time counters.
+        """
+        rg = self.response_generator
+        lines = []
+
+        def gauge(name, value, help_text):
+            lines.append(f"# HELP {name} {help_text}")
+            lines.append(f"# TYPE {name} gauge")
+            lines.append(f"{name} {value}")
+
+        def counter(name, value, help_text):
+            lines.append(f"# HELP {name} {help_text}")
+            lines.append(f"# TYPE {name} counter")
+            lines.append(f"{name} {value}")
+
+        n_entries = len(rg.prompt_cache)
+        gauge(
+            "mlx_lm_prompt_cache_entries",
+            n_entries,
+            "Number of distinct KV caches held in the prompt cache",
+        )
+        gauge(
+            "mlx_lm_prompt_cache_bytes",
+            int(rg.prompt_cache.nbytes),
+            "Total bytes of KV cache held in the prompt cache",
+        )
+        lines.append("# HELP mlx_lm_prompt_cache_entries_by_type KV entries by type")
+        lines.append("# TYPE mlx_lm_prompt_cache_entries_by_type gauge")
+        for cache_type, stats in rg.prompt_cache.stats_by_type().items():
+            lines.append(
+                f'mlx_lm_prompt_cache_entries_by_type{{type="{cache_type}"}} '
+                f"{stats['n_sequences']}"
+            )
+
+        counter(
+            "mlx_lm_prompt_cache_hits_total",
+            METRIC_COUNTERS["prompt_cache_hits"],
+            "Requests whose prompt found a reusable KV prefix",
+        )
+        counter(
+            "mlx_lm_prompt_cache_misses_total",
+            METRIC_COUNTERS["prompt_cache_misses"],
+            "Requests whose prompt found no reusable KV prefix",
+        )
+        counter(
+            "mlx_lm_prompt_cache_tokens_reused_total",
+            METRIC_COUNTERS["prompt_cache_tokens_reused"],
+            "Total prompt tokens skipped via KV prefix reuse",
+        )
+        counter(
+            "mlx_lm_requests_completed_total",
+            METRIC_COUNTERS["requests_completed"],
+            "Requests that finished generating",
+        )
+
+        # MLX-MADS PAGED-KV: the course's block-level content-addressed
+        # prefix cache (a4_serve/kv_cache.py), mirrored per request.
+        if rg._paged_kv is not None:
+            with rg._paged_kv_lock:
+                ps = rg._paged_kv.stats()
+                prefilled = getattr(rg._paged_kv, "prefilled_tokens", 0)
+            counter(
+                "mlx_lm_paged_kv_prefix_hits_total",
+                ps["prefix_hits"],
+                "Requests whose token prefix matched >=1 cached block",
+            )
+            counter(
+                "mlx_lm_paged_kv_prefix_misses_total",
+                ps["prefix_misses"],
+                "Requests whose token prefix matched no cached block",
+            )
+            counter(
+                "mlx_lm_paged_kv_skipped_tokens_total",
+                ps["skipped_prefill_tokens"],
+                "Prompt tokens skipped via block-level prefix match",
+            )
+            counter(
+                "mlx_lm_paged_kv_prefilled_tokens_total",
+                prefilled,
+                "Prompt tokens actually prefilled (after skips)",
+            )
+            gauge(
+                "mlx_lm_paged_kv_blocks",
+                ps["blocks"],
+                "Blocks currently held in the paged prefix cache",
+            )
+            gauge(
+                "mlx_lm_paged_kv_cached_tokens",
+                ps["kv_tokens_cached"],
+                "Tokens of KV represented by cached blocks",
+            )
+            gauge(
+                "mlx_lm_paged_kv_hit_rate",
+                round(ps["hit_rate"], 6),
+                "Fraction of requests with a block-level prefix match",
+            )
+
+        bg = rg._active_batch_generator
+        n_inflight = len(rg._batch_results) if rg._batch_results is not None else 0
+        queued = len(rg._unprocessed) + rg.requests.qsize() if rg._unprocessed else 0
+        gauge(
+            "mlx_lm_inflight_requests", n_inflight, "Requests in the active batch"
+        )
+        gauge("mlx_lm_queued_requests", queued, "Requests waiting for a slot")
+
+        prompt_tokens = METRIC_COUNTERS["prompt_tokens"]
+        prompt_time = METRIC_COUNTERS["prompt_time"]
+        generation_tokens = METRIC_COUNTERS["generation_tokens"]
+        generation_steps = METRIC_COUNTERS["generation_steps"]
+        decode_time = METRIC_COUNTERS["decode_time"]
+        kv_bytes = bg.prompt_cache_nbytes if bg is not None else 0
+        counter(
+            "mlx_lm_prompt_tokens_total",
+            prompt_tokens,
+            "Prompt (prefill) tokens processed this session",
+        )
+        counter(
+            "mlx_lm_prompt_time_seconds_total",
+            round(prompt_time, 6),
+            "Seconds spent in prompt processing this session",
+        )
+        counter(
+            "mlx_lm_generation_tokens_total",
+            generation_tokens,
+            "Tokens generated this session",
+        )
+        counter(
+            "mlx_lm_generation_steps_total",
+            generation_steps,
+            "Decode steps taken this session",
+        )
+        counter(
+            "mlx_lm_decode_time_seconds_total",
+            round(decode_time, 6),
+            "Seconds spent in decode steps this session",
+        )
+        gauge(
+            "mlx_lm_kv_active_bytes",
+            int(kv_bytes),
+            "Bytes of KV cache held by active batch sequences",
+        )
+        gauge(
+            "mlx_lm_peak_memory_bytes",
+            int(mx.get_peak_memory()),
+            "Process peak memory in bytes",
+        )
+
+        body = ("\n".join(lines) + "\n").encode()
+        self.send_response(200)
+        self.send_header("Content-type", "text/plain; version=0.0.4")
+        self._set_cors_headers()
+        self.end_headers()
+        self.wfile.write(body)
+        self.wfile.flush()
+
