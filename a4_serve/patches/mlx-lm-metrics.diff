+# MLX-MADS METRICS PATCH (CS2680 A4): process-wide counters and gauges exposed
+# at GET /metrics. Plain ints updated under the GIL; reads are racy by at most
+# one increment, which is fine for monitoring.
+METRIC_COUNTERS = {
+    "prompt_cache_hits": 0,
+    "prompt_cache_misses": 0,
+    "prompt_cache_tokens_reused": 0,
+    "requests_completed": 0,
+    # Session-monotonic token/time totals (accumulate batch-generator
+    # deltas, so they survive batch-generator resets):
+    "prompt_tokens": 0,
+    "prompt_time": 0.0,
+    "generation_tokens": 0,
+    "generation_steps": 0,
+    "decode_time": 0.0,
+}
+
+
+def _count_prompt_cache_fetch(n_reused: int):
+    if n_reused > 0:
+        METRIC_COUNTERS["prompt_cache_hits"] += 1
+        METRIC_COUNTERS["prompt_cache_tokens_reused"] += n_reused
+    else:
+        METRIC_COUNTERS["prompt_cache_misses"] += 1
+
+
+_BG_COUNTER_FIELDS = (
+    "prompt_tokens",
+    "prompt_time",
+    "generation_tokens",
+    "generation_steps",
+    "decode_time",
+)
+
+
+def _account_bg_counters(rg, bg):
+    """Fold the batch generator's counter deltas into the session counters."""
+    c = bg._counters
+    last = rg._last_bg_counters or tuple(0.0 for _ in _BG_COUNTER_FIELDS)
+    cur = tuple(getattr(c, f) for f in _BG_COUNTER_FIELDS)
+    rg._last_bg_counters = cur
+    for name, cur_v, last_v in zip(_BG_COUNTER_FIELDS, cur, last):
+        METRIC_COUNTERS[name] += max(0.0, cur_v - last_v)
+
